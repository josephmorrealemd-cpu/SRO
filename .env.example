GEMINI_API_KEY="MY_GEMINI_API_KEY"

APP_URL="MY_APP_URL"

# Twilio (server.ts only; not used on Netlify static site)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
