{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "An appointment or consultation request.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Patient's full name." },
        "email": { "type": "string", "format": "email", "description": "Patient's email address." },
        "phone": { "type": "string", "description": "Patient's phone number." },
        "date": { "type": "string", "format": "date", "description": "Preferred appointment date." },
        "type": { "type": "string", "description": "Type of booking (e.g., Appointment, Consultation)." },
        "condition": { "type": "string", "description": "The specific condition or area of concern." },
        "reportName": { "type": "string", "description": "Name of the uploaded imaging report file." },
        "status": { 
          "type": "string", 
          "enum": ["pending", "confirmed", "cancelled"],
          "description": "The current status of the booking." 
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the booking was created." }
      },
      "required": ["name", "email", "phone", "date", "type", "createdAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "A message sent through the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender's name." },
        "email": { "type": "string", "format": "email", "description": "Sender's email address." },
        "subject": { "type": "string", "description": "Subject of the message." },
        "message": { "type": "string", "description": "The message content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the message was sent." }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "A tracked user event.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["page_view", "click", "ai_interaction", "pain_quiz_completed", "decision_tool_interaction", "guide_downloaded", "email_nurture_triggered", "nurture_email_triggered"] },
        "page": { "type": "string" },
        "element": { "type": "string" },
        "metadata": { "type": "string" },
        "sessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "page", "sessionId", "createdAt"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "A heartbeat for an active session.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "page": { "type": "string" }
      },
      "required": ["sessionId", "lastActive", "page"]
    },
    "AppState": {
      "title": "AppState",
      "description": "Global application state settings.",
      "type": "object",
      "properties": {
        "hologramUrl": { "type": "string", "description": "The current daily hologram image URL." },
        "lastHologramUpdate": { "type": "string", "format": "date-time", "description": "When the hologram was last updated." },
        "lastAttemptAt": { "type": "string", "format": "date-time", "description": "When the last AI generation attempt occurred." }
      },
      "required": ["hologramUrl", "lastHologramUpdate"]
    },
    "Call": {
      "title": "Call",
      "description": "An incoming twilio call, active transcript session, or voicemail.",
      "type": "object",
      "properties": {
        "callSid": { "type": "string" },
        "callerPhone": { "type": "string" },
        "callerName": { "type": "string" },
        "status": { "type": "string", "enum": ["ringing", "active", "completed", "voicemail"] },
        "voicemailUrl": { "type": "string" },
        "voicemailDuration": { "type": "number" },
        "transcript": { "type": "array" },
        "aiSummary": { "type": "string" },
        "aiUrgency": { "type": "string" },
        "aiIntent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callSid", "callerPhone", "status", "createdAt"]
    },
    "PainQuizResult": {
      "title": "PainQuizResult",
      "description": "Patient self-assessment quiz submission with biologics-first clinical recommendation.",
      "type": "object",
      "properties": {
        "joint": { "type": "string", "description": "Primary joint or area of pain" },
        "duration": { "type": "string", "description": "Duration of injury/pain" },
        "painLevel": { "type": "string", "description": "Pain intensity and characteristics" },
        "limitations": { "type": "array", "description": "List of functional limitations" },
        "priorTreatments": { "type": "array", "description": "Treatments previously tried" },
        "surgeryStatus": { "type": "string", "description": "Surgical recommendation status" },
        "goals": { "type": "string", "description": "Patient primary recovery goal" },
        "recommendation": { "type": "string", "description": "Biologics recommendation title" },
        "treatment": { "type": "string", "description": "Biologic treatment protocol" },
        "rationale": { "type": "string", "description": "Clinical explanation for protocol" },
        "name": { "type": "string", "description": "Optional patient name" },
        "email": { "type": "string", "format": "email", "description": "Optional patient email" },
        "phone": { "type": "string", "description": "Optional patient phone" },
        "sessionId": { "type": "string", "description": "User session ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the quiz was submitted" }
      },
      "required": ["joint", "duration", "recommendation", "treatment", "createdAt"]
    },
    "GuideDownload": {
      "title": "GuideDownload",
      "description": "Gated patient lead download for regenerative medicine guide.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Patient full name" },
        "email": { "type": "string", "format": "email", "description": "Patient email address" },
        "phone": { "type": "string", "description": "Optional phone number" },
        "guideName": { "type": "string", "description": "Title of the downloaded guide" },
        "jointConcern": { "type": "string", "description": "Primary joint or condition of concern" },
        "sessionId": { "type": "string", "description": "User session ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the guide was downloaded" }
      },
      "required": ["name", "email", "guideName", "createdAt"]
    }
  },
  "firestore": {
    "bookings": {
      "schema": "Booking",
      "description": "Collection of appointment and consultation requests."
    },
    "contact_messages": {
      "schema": "ContactMessage",
      "description": "Collection of messages from the contact form."
    },
    "analytics_events": {
      "schema": "AnalyticsEvent",
      "description": "Collection of page views and user interactions."
    },
    "active_sessions": {
      "schema": "ActiveSession",
      "description": "Collection of currently active user sessions."
    },
    "app_state": {
      "schema": "AppState",
      "description": "Global application state settings."
    },
    "calls": {
      "schema": "Call",
      "description": "Log of incoming Twilio receptionist sessions, live transcripts, and recorded voicemails."
    },
    "pain_quiz_results": {
      "schema": "PainQuizResult",
      "description": "Self-assessment quiz results and personalized biologics recommendations."
    },
    "guide_downloads": {
      "schema": "GuideDownload",
      "description": "Gated guide downloads and patient lead captures."
    }
  }
}
